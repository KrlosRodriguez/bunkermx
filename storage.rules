rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Nota: el límite es <= 10 MB, igual que la validación del cliente
    // (documentos.js rechaza > MAX_SIZE). Con < se colaba un archivo de
    // exactamente 10 MB en el navegador y Storage lo rebotaba sin explicación.
    match /documentos/clientes/{entityId}/{tipo}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && (firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol in ['admin', 'ventas'])
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('^(application/pdf|image/jpeg|image/png)$');
      allow delete: if request.auth != null
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    match /documentos/proveedores/{entityId}/{tipo}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && (firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol in ['admin', 'ventas'])
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('^(application/pdf|image/jpeg|image/png)$');
      allow delete: if request.auth != null
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    match /documentos/partners/{entityId}/{tipo}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin'
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('^(application/pdf|image/jpeg|image/png)$');
      allow delete: if request.auth != null
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }
  }
}
