rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Nota: Firestore cachea get() por request, así que múltiples
    // llamadas al mismo doc no consumen reads adicionales en la misma evaluación.
    function userData() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function isAuthenticated() {
      return request.auth != null && userData().activo == true;
    }

    function isAdmin() {
      return isAuthenticated() && userData().rol == 'admin';
    }

    function isAdminOrVentas() {
      return isAuthenticated() && userData().rol in ['admin', 'ventas'];
    }

    function isAdminOrVentasOrProduccion() {
      return isAuthenticated() && userData().rol in ['admin', 'ventas', 'produccion'];
    }

    // ────────────────────────────────────────────────────────────────
    // Sobre la validación de campos (hasOnly)
    //
    // Las listas blancas de campos que existían aquí se escribieron desde
    // la especificación, no desde el código del panel, y bloqueaban
    // prácticamente toda escritura (ver 2026-10-13: "Missing or
    // insufficient permissions" al guardar servicios, catálogo, pagos,
    // partners, cotizaciones, documentos y usuarios).
    //
    // Dos motivos para no reintroducirlas tal cual:
    //   1. En un update, request.resource.data es el documento COMPLETO
    //      ya fusionado, no solo los campos modificados. Cualquier campo
    //      heredado (p. ej. de la doble escritura Sheets → Firestore del
    //      Apps Script, que usa otro esquema) hace fallar el update.
    //   2. No hay emulador ni tests, así que un desfase entre la lista y
    //      el cliente no se detecta hasta que el usuario no puede guardar.
    //
    // La autorización sigue siendo por rol (y por colección). Si se
    // quiere volver a validar campos, hacerlo colección por colección y
    // probándolo antes con `firebase emulators:start --only firestore`.
    // ────────────────────────────────────────────────────────────────

    match /usuarios/{uid} {
      allow read: if isAdmin() || request.auth.uid == uid;
      // Lista blanca conservada a propósito: protege la escalación de rol.
      // Mantener sincronizada con usuarios.js y functions/index.js.
      allow create, update: if isAdmin() && request.resource.data.keys().hasOnly(['nombre','email','rol','activo','createdAt','updatedAt']);
      allow delete: if isAdmin();
    }

    match /cotizaciones/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdminOrVentas();
      allow delete: if isAdmin();

      match /actividad/{actId} {
        allow read: if isAuthenticated();
        allow create: if isAdminOrVentas();
      }
    }

    match /clientes/{docId} {
      allow read: if isAdminOrVentas();
      allow create, update, delete: if isAdminOrVentas();

      match /documentos/{documentoId} {
        allow read: if isAuthenticated();
        allow create, update: if isAdminOrVentas();
        allow delete: if isAdmin();
      }
    }

    match /proveedores/{docId} {
      allow read: if isAdminOrVentas();
      allow create, update, delete: if isAdminOrVentas();

      match /documentos/{documentoId} {
        allow read: if isAuthenticated();
        allow create, update: if isAdminOrVentas();
        allow delete: if isAdmin();
      }

      match /servicios/{srvId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAdminOrVentas();
      }

      match /bloques/{bloqueId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAdminOrVentas();
      }
    }

    match /catalogo/{docId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdminOrVentas();
    }

    match /eventos/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdminOrVentasOrProduccion();

      match /tareas/{tareaId} {
        allow read: if isAuthenticated();
        allow create, update: if isAdminOrVentasOrProduccion();
        allow delete: if isAdmin();
      }
    }

    match /plantillas/{docId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /config/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── Finanzas: solo admin puede leer y escribir datos bancarios/pagos ──
    match /partners/{docId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin();

      match /documentos/{documentoId} {
        allow read: if isAuthenticated();
        allow create, update: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    match /pagos/{docId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin();
    }

    match /cotizacionPartners/{docId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin();
    }

    match /cuentasCobrar/{docId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin();
    }

    // Tabla de vinculación cotización ↔ proveedor. No es dato financiero
    // reservado: la crea automáticamente cotizar-bnk.js (admin+ventas) al
    // guardar una cotización con conceptos de proveedor, y la leen el tab
    // COTIZACIONES y REPORTES. Dejarla admin-only hacía fallar el guardado
    // de BNK a los usuarios de ventas. El costo de proveedor que guarda
    // (montoTotal) ya es visible para ventas en la colección proveedores.
    match /cotizacionProveedores/{docId} {
      allow read, create, update, delete: if isAdminOrVentas();
    }

    match /auditLog/{docId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /actividadGlobal/{docId} {
      allow read: if isAuthenticated();
      // Lista blanca verificada contra BNK_DB.logActividad() (firestore.js).
      allow create: if isAuthenticated() && request.resource.data.keys().hasOnly(['tipo','entidad','entidadId','referencia','detalle','usuario','usuarioId','timestamp']);
      allow update, delete: if false;
    }

    // Collection group queries para servicios y bloques
    match /{path=**}/servicios/{srvId} {
      allow read: if isAuthenticated();
    }

    match /{path=**}/bloques/{bloqueId} {
      allow read: if isAuthenticated();
    }
  }
}
