rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Nota: Firestore cachea get() por request, así que múltiples
    // llamadas al mismo doc no consumen reads adicionales en la misma evaluación.
    function userData() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function isAuthenticated() {
      return request.auth != null && userData().activo == true;
    }

    function isAdmin() {
      return isAuthenticated() && userData().rol == 'admin';
    }

    function isAdminOrVentas() {
      return isAuthenticated() && userData().rol in ['admin', 'ventas'];
    }

    function isAdminOrProduccion() {
      return isAuthenticated() && userData().rol in ['admin', 'produccion'];
    }

    match /usuarios/{uid} {
      allow read: if isAdmin() || request.auth.uid == uid;
      allow create, update: if isAdmin() && request.resource.data.keys().hasOnly(['nombre','email','rol','activo','createdAt']);
      allow delete: if isAdmin();
    }

    match /cotizaciones/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdminOrVentas() && request.resource.data.keys().hasOnly(['folio','cliente','estado','fecha','fechaEvento','conceptos','total','tipo','clienteId','clienteNombre','folioMNT','marca','desgloseVenues','condiciones','subtotal','iva','descuento','notas','createdAt','fechaCreacion','evento','telefono','email','espacios','precioTotal','origen','estilo','empresa','contacto','eventoTipo','numPersonas','horario','montaje','extras','tipoEvento','reqAdicionales','comentarios','updatedAt','desgloseServicios','descuentoPorcentaje','anticipo','anticipoPorcentaje']);
      allow delete: if isAdmin();

      match /actividad/{actId} {
        allow read: if isAuthenticated();
        allow create: if isAdminOrVentas() && request.resource.data.keys().hasOnly(['tipo','texto','usuario','fecha','createdAt']);
      }
    }

    match /clientes/{docId} {
      allow read: if isAdminOrVentas();
      allow create, update, delete: if isAdminOrVentas();

      match /documentos/{docId} {
        allow read: if isAuthenticated();
        allow create, update: if isAdminOrVentas() && request.resource.data.keys().hasOnly(['tipo','tipoLibre','nombre','url','storagePath','vigente','creadoPor','createdAt','contentType','size']);
        allow delete: if isAdmin();
      }
    }

    match /proveedores/{docId} {
      allow read: if isAdminOrVentas();
      allow create, update, delete: if isAdminOrVentas();

      match /documentos/{docId} {
        allow read: if isAuthenticated();
        allow create, update: if isAdminOrVentas() && request.resource.data.keys().hasOnly(['tipo','tipoLibre','nombre','url','storagePath','vigente','creadoPor','createdAt','contentType','size']);
        allow delete: if isAdmin();
      }

      match /servicios/{srvId} {
        allow read: if isAuthenticated();
        allow create, update: if isAdminOrVentas() && request.resource.data.keys().hasOnly(['nombre','categoria','costoUnitario','precioCliente','unidad','descripcion','bloqueId','orden']);
        allow delete: if isAdminOrVentas();
      }

      match /bloques/{bloqueId} {
        allow read: if isAuthenticated();
        allow create, update: if isAdminOrVentas() && request.resource.data.keys().hasOnly(['nombre','precioManual','usaPrecioManual','orden']);
        allow delete: if isAdminOrVentas();
      }
    }

    match /catalogo/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdminOrVentas() && request.resource.data.keys().hasOnly(['nombre','categoria','precio','precioWeekend','precioMontaje','descripcion','unidad','activo','orden']);
      allow delete: if isAdminOrVentas();
    }

    match /eventos/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && userData().rol in ['admin', 'ventas', 'produccion'] && request.resource.data.keys().hasOnly(['nombre','fecha','espacio','cotizacionId','folio','estado','plantilla','descripcion','createdAt','updatedAt','cliente','fechaEvento','folioCotizacion','tareasCompletadas','tareasTotal']);

      match /tareas/{tareaId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() && userData().rol in ['admin', 'ventas', 'produccion'] && request.resource.data.keys().hasOnly(['nombre','descripcion','completada','orden','notas','responsable','responsableNombre','fechaLimite']);
        allow delete: if isAdmin();
      }
    }

    match /plantillas/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() && request.resource.data.keys().hasOnly(['nombre','tareas','createdAt','updatedAt']);
      allow delete: if isAdmin();
    }

    match /config/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── Finanzas: solo admin puede leer y escribir datos bancarios/pagos ──
    match /partners/{docId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && request.resource.data.keys().hasOnly(['nombre','empresa','email','telefono','rfc','curp','clabe','banco','titular','notas','activo','createdAt','comision','especialidad','swift','iban','noAplicaExtranjero','direccion','cp','ciudad','estado','regimen','usoCfdi','formaPago','metodoPago','domicilioFiscal']);

      match /documentos/{docId} {
        allow read: if isAuthenticated();
        allow create, update: if isAdmin() && request.resource.data.keys().hasOnly(['tipo','tipoLibre','nombre','url','storagePath','vigente','creadoPor','createdAt','contentType','size']);
        allow delete: if isAdmin();
      }
    }

    match /pagos/{docId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && request.resource.data.keys().hasOnly(['cotizacionId','cotizacionFolio','partnerId','partnerNombre','monto','fecha','concepto','comprobante','notas','createdAt','tipo','estado','parcialidad','totalParcialidades','proveedorId','proveedorNombre']);
    }

    match /cotizacionPartners/{docId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && request.resource.data.keys().hasOnly(['cotizacionId','cotizacionFolio','partnerId','partnerNombre','createdAt','autoVinculado']);
    }

    match /cuentasCobrar/{docId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && request.resource.data.keys().hasOnly(['folioProyecto','folioFactura','prefactura','lider','cliente','proyecto','concepto','montoSinIva','fechaIngreso','estado','notas','createdAt','updatedAt']);
    }

    match /cotizacionProveedores/{docId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && request.resource.data.keys().hasOnly(['cotizacionId','cotizacionFolio','proveedorId','proveedorNombre','createdAt','autoVinculado']);
    }

    match /auditLog/{docId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /actividadGlobal/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.keys().hasOnly(['tipo','entidad','entidadId','referencia','detalle','usuario','usuarioId','timestamp']);
      allow update, delete: if false;
    }

    // Collection group queries para servicios y bloques
    match /{path=**}/servicios/{srvId} {
      allow read: if isAuthenticated();
    }

    match /{path=**}/bloques/{bloqueId} {
      allow read: if isAuthenticated();
    }
  }
}
